# ============================================
# Enterprise RAG Platform — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
#
# How to get each value:
#   Clerk        → https://dashboard.clerk.com → API Keys
#   Supabase     → https://supabase.com/dashboard → Settings → API
#   LangSmith    → https://smith.langchain.com → Settings → API Keys
#   OpenRouter   → User provides at runtime (BYOK)

# ---------- CLERK (Authentication) ----------
# Frontend (public — safe for browser, prefix NEXT_PUBLIC_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Backend (secret — server only, NEVER expose to frontend)
CLERK_SECRET_KEY=sk_test_your_key_here

# ---------- SUPABASE (Database + Storage) ----------
# All server-only — NEVER expose to frontend
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_key_here
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_STORAGE_BUCKET=documents

# ---------- REDIS ----------
REDIS_URL=redis://redis:6379/0

# ---------- JINA AI (Neural Cross-Encoder) ----------
JINA_API_KEY=jina_your_key_here
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual

# ---------- RABBITMQ & CELERY ----------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- STORAGE (Supabase or AWS S3) ----------
STORAGE_BACKEND=supabase
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=documents
S3_ENDPOINT_URL=

# ---------- LANGSMITH (Observability) ----------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_your_key_here
LANGCHAIN_PROJECT=enterprise-rag

# ---------- APP ----------
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---------- PERSISTENT MEMORY (Optional defaults) ----------
MAX_RECENT_MESSAGES=10
SUMMARY_MESSAGE_THRESHOLD=20
MAX_MEMORY_RESULTS=5
MAX_HISTORY_RESULTS=5
MAX_RAG_RESULTS=5
MAX_CONTEXT_TOKENS=6000

