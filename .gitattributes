# Normalize line endings to LF for all text files.
# This ensures consistent behaviour between Windows (CRLF) and Linux/macOS (LF) CI runners.
* text=auto eol=lf

# Explicitly mark binary files to prevent corruption.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.tar binary
*.gz binary
